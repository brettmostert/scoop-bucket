            "hash": "376b47c6ce272c9f476c5d53fb9713287574a920441c3453501e3956e5dd22b6"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.91.4/acmd-0.91.4-windows-arm64.zip",
            "hash": "7c597aad45685700bee0b7116aa6a4373fb1d891d3ded194c241bffb342e04a3"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
