{
    "version": "0.91.3",
    "description": "Agent Command: use your hosts' agent sessions from any terminal. On Windows acmd connects to hosts, and runs no sessions of its own.",
    "homepage": "https://github.com/brettmostert/agent-command",
    "license": "MIT",
    "notes": [
        "acmd's daemon now starts at logon. To use a host's sessions:",
        "  acmd remote add <name> <host:port> --fingerprint <its fingerprint>",
        "then authorize this machine on the host."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.91.3/acmd-0.91.3-windows-amd64.zip",
            "hash": "f121fa7451c00c8f83a1e250e02a13234dbf49ce7524923ca155866ff5ce42ed"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.91.3/acmd-0.91.3-windows-arm64.zip",
            "hash": "618c6bdd2eea6a21fb710a1e78d17e4ad204b456f5b3e6b363b55d7f3c678d3a"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
