        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.91.1/acmd-0.91.1-windows-arm64.zip",
            "hash": "fc794426b6506253aad41407603e0227772c6b95a77680dd949c05c0b707554f"
        }
    },
    "bin": "acmd.exe",
