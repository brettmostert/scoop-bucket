{
    "version": "0.97.0",
    "description": "Agent Command: use your hosts' agent sessions from any terminal. On Windows acmd connects to hosts, and runs no sessions of its own.",
    "homepage": "https://github.com/brettmostert/agent-command",
    "license": "MIT",
    "notes": [
        "acmd's daemon now starts at logon. To use a host's sessions:",
        "  acmd remote add <name> <host:port> --fingerprint <its fingerprint>",
        "then authorize this machine on the host."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.97.0/acmd-0.97.0-windows-amd64.zip",
            "hash": "3c0943d3e2c350bae6a7019932144004e9a57164e28886b3796e210aa32ce0af"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.97.0/acmd-0.97.0-windows-arm64.zip",
            "hash": "51c73aeae1d5961236c0db4441901e00bf5eead2a637e2d80e0742b78f67f4e3"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
