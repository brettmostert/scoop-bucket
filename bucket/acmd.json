{
    "version": "0.92.0",
    "description": "Agent Command: use your hosts' agent sessions from any terminal. On Windows acmd connects to hosts, and runs no sessions of its own.",
    "homepage": "https://github.com/brettmostert/agent-command",
    "license": "MIT",
    "notes": [
        "acmd's daemon now starts at logon. To use a host's sessions:",
        "  acmd remote add <name> <host:port> --fingerprint <its fingerprint>",
        "then authorize this machine on the host."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.92.0/acmd-0.92.0-windows-amd64.zip",
            "hash": "28ae73a1dcfcf46e12c39615294c51d99a079362966c9aba215b7a7de2c0427a"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.92.0/acmd-0.92.0-windows-arm64.zip",
            "hash": "dd5f870210fa47378732866ac9c2cb34cabe16eccb3ebfded12f356cc20b38fd"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
        "github": "https://github.com/brettmostert/agent-command"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v$version/acmd-$version-windows-amd64.zip"
