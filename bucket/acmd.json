        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.89.0/acmd-0.89.0-windows-arm64.zip",
            "hash": "f57fba2469836b5b0b2594d30b8336ee8fb7dfd5385ebeec639b46ec5abdaac7"
        }
    },
    "bin": "acmd.exe",
