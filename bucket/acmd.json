{
    "version": "0.93.0",
    "description": "Agent Command: use your hosts' agent sessions from any terminal. On Windows acmd connects to hosts, and runs no sessions of its own.",
    "homepage": "https://github.com/brettmostert/agent-command",
    "license": "MIT",
    "notes": [
        "acmd's daemon now starts at logon. To use a host's sessions:",
        "  acmd remote add <name> <host:port> --fingerprint <its fingerprint>",
        "then authorize this machine on the host."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.93.0/acmd-0.93.0-windows-amd64.zip",
            "hash": "641c6984cfa183cc3955389d7f74adbde39174bc33f5413993a998b7cc52baea"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.93.0/acmd-0.93.0-windows-arm64.zip",
            "hash": "9ff349d7083eaa3835d0e8b14b0c47a921daf60dd20b28cf66c8b253aa0073ac"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
