{
    "version": "0.100.0",
    "description": "Agent Command: use your hosts' agent sessions from any terminal. On Windows acmd connects to hosts, and runs no sessions of its own.",
    "homepage": "https://github.com/brettmostert/agent-command",
    "license": "MIT",
    "notes": [
        "acmd's daemon now starts at logon. To use a host's sessions:",
        "  acmd remote add <name> <host:port> --fingerprint <its fingerprint>",
        "then authorize this machine on the host."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.100.0/acmd-0.100.0-windows-amd64.zip",
            "hash": "5ded064ff932ff7d1707b2297948b641b69470789388f8cffed4fcadf02bc874"
        },
        "arm64": {
            "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v0.100.0/acmd-0.100.0-windows-arm64.zip",
            "hash": "a76308f75d265dcde2e8fefc178ec8de777167c6fd24cf9d0c96ddad79d36430"
        }
    },
    "bin": "acmd.exe",
    "post_install": "& \"$dir\\acmd.exe\" init",
    "pre_uninstall": "& \"$dir\\acmd.exe\" uninstall --yes",
    "checkver": {
        "github": "https://github.com/brettmostert/agent-command"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v$version/acmd-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v$version/acmd-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
